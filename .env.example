# Social Pilot — environment template. Copy to `.env` and fill.
# NEVER commit `.env`. See SECURITY.md.

# --- Core ---
SP_SECRET_KEY=change-me-to-64-hex-chars
SP_ENV=development                # development | production
SP_HOST=127.0.0.1
SP_PORT=8100

# --- Database (SQLite for MVP; per-instance, single-tenant) ---
SP_DATABASE_URL=sqlite:///./data/social-pilot.db

# --- LLM / media provider defaults (user-overridable in Settings) ---
# provider: openrouter | openai_compatible | ollama | none
# OpenRouter = ONE key for TEXT + IMAGE (nano-banana/Flux) + VIDEO (Veo/Wan).
# For ollama, the user enters the device IP+port in Settings (local or remote).
SP_LLM_PROVIDER=openrouter
SP_LLM_BASE_URL=https://openrouter.ai/api/v1
SP_LLM_API_KEY=
SP_LLM_MODEL=anthropic/claude-sonnet-4              # default TEXT model
SP_LLM_IMAGE_MODEL=google/gemini-2.5-flash-image    # default IMAGE model
SP_LLM_VIDEO_MODEL=google/veo-3.1                   # default VIDEO model (optional)

# Local image gen (optional, privacy-first) — ComfyUI or compatible
SP_COMFYUI_URL=                    # http://IP:PORT (empty = use OpenRouter)

# --- Backup (auto) ---
SP_BACKUP_DIR=./backups
SP_BACKUP_SCHEDULE=03:00           # daily local backup (HH:MM)
SP_BACKUP_S3_URL=                  # optional S3/B2-compatible endpoint

# --- Platform OAuth (TikTok / Instagram / Facebook Login) ---
SP_TIKTOK_CLIENT_KEY=
SP_TIKTOK_CLIENT_SECRET=
SP_INSTAGRAM_CLIENT_ID=
SP_INSTAGRAM_CLIENT_SECRET=
SP_INSTAGRAM_REDIRECT_URI=https://YOUR_DOMAIN/api/connect/instagram/callback
SP_FACEBOOK_CLIENT_ID=             # optional — for the Graph API route if a
SP_FACEBOOK_CLIENT_SECRET=         # Facebook Page is required

# --- Public base URL (media URLs, OAuth callbacks, previews, monitor links) ---
SP_PUBLIC_BASE_URL=http://127.0.0.1:8100

# --- Multi-client management (command-center telemetry) ---
# Empty = management API disabled. Generate with: python scripts/generate_management_token.py
SP_MANAGEMENT_TOKEN=
SP_INSTANCE_LABEL=Social Pilot        # friendly name on the command-center dashboard

# The watermark key for AI-generated images (AI Act Article 50(2), app/ai_marking.py).
# Numeric. It must never change once content is published: marks written with one value cannot be read
# with another. Generate a NEW value for each new installation — a value that has ever been committed to
# a repository is not a secret, and this one has a past: the historic constant lived in app/ai_marking.py
# until 2026-10-05, so any installation that has published marks with it holds a value the repository
# knows. The devnet keeps it (a draft, nothing published); production's .env takes a fresh one.
SP_AI_MARKING_KEY=

# RETIRED, do not reuse: the value this project shipped until 2026-10-05 lived in app/ai_marking.py and then
# in a commit message, so it is in this repository's history and is not a secret. The devnet (a draft, nothing
# published) still carries it and its test marks are readable with it; production must be given a fresh value
# before it publishes anything, and afterwards the value never changes.
